{
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/cache": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/out": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "solidity.formatter": "forge",
  "typescript.tsdk": "node_modules/typescript/lib"
}
