{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auralis: Build",
      "type": "shell",
      "command": "forge build --deny warnings",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Auralis: Test",
      "type": "shell",
      "command": "forge test -vv",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Auralis: Format",
      "type": "shell",
      "command": "forge fmt",
      "problemMatcher": []
    },
    {
      "label": "Auralis: Local CI",
      "type": "shell",
      "command": "bash scripts/ci.sh",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Auralis: Client Test",
      "type": "shell",
      "command": "npm run test:client",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Auralis: Client Typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": "$tsc"
    }
  ]
}
